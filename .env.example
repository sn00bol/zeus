# ZEUS Enviroments configuration
# Normally, setup.py generates a .env file for you, so you don't need to edit this file.
# If you do, make sure do not change anything at # Docker/database Config (or do it with your own risk)

# ============================================================
# Platform and LLM configuration
# ============================================================

# Shared host for the selected LLM provider
LLM_HOST=localhost
# Docker Compose connects to host.docker.internal by default. Set this only
# when the provider runs somewhere else (for example, another Compose service).
ZEUS_LLM_HOST=host.docker.internal

# Leave blank to use the selected provider's default port:
# Ollama: 11434 | LM Studio: 1234 | llama.cpp: 8080
LLM_PORT=

# Discord ↔ Python bridge server
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5000
BRIDGE_URL=http://127.0.0.1:5000
BRIDGE_TOKEN= # setup.py generates a private token

# ============================================================
# Platform Config
# ============================================================

# Discord
DISCORD_BOT_API_KEY=YOUR_BOT_TOKEN
PFX= # Optional message-command prefix; leave blank to use slash commands only
OWNER_ID= # Comma-separated Discord user IDs allowed to restart or stop ZEUS

# Telegram
TELEGRAM_BOT_API_KEY=YOUR_BOT_TOKEN

# Discord/Telegram slash config
SLASH_GUILD_ID= # Optional: use a server ID for near-instant command updates
SLASH_RESET=false # Set true for one startup to delete old slash commands and register the current ones

# ============================================================
# Docker/database Config
# ============================================================

# PostgreSQL database (setup.py generates DB_PASSWORD)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=zeus
DB_USER=zeus
DB_PASSWORD= # Optional: leave blank to generate a random password on first run

# searXNG
SEARXNG_SECRET= # setup.py generates a private SEARXNG secret
SEARXNG_VERSION=latest
SEARXNG_PORT=8888
SEARXNG_URL=http://searxng:8080

# Docker
ZEUS_IMAGE=zeus:latest
ZEUS_PULL_POLICY=build
ZEUS_WATCHTOWER_ENABLED=false
ZEUS_UID=1000
ZEUS_GID=1000
ZEUS_MEMORY_LIMIT=1g
ZEUS_CPUS=1.0